{
  "name": "lastro",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "npm run db:migrate:test && npm run e2e:build && start-server-and-test e2e:start http://localhost:3100 \"cypress run\"",
    "e2e:build": "dotenv -e .env.test -- next build",
    "e2e:start": "dotenv -e .env.test -- next start --port 3100",
    "cypress:open": "cypress open",
    "db:up": "docker compose up -d",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:test": "dotenv -e .env.test -- drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.0",
    "nodemailer": "^10.1.1",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cypress": "^16.1.1",
    "dotenv": "^18.0.7",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "start-server-and-test": "^3.0.13",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }
}
